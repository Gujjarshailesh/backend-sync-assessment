# Application
NODE_ENV=development
PORT=3000

# Postgres connection string (Supabase: Project Settings -> Database ->
# Connection string -> URI; use the pooled "Transaction" connection string
# for the running app, since serverless/short-lived connections work
# better with PgBouncer pooling than a direct connection).
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Later phases will add further required variables here as they're introduced
# (HUBSPOT_*, GOOGLE_*, STRIPE_* credentials, etc.) - keep this file in sync
# with src/config/env.validation.ts so `.env.example` always reflects exactly
# what the app needs to boot.
