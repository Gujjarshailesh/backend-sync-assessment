# Application
NODE_ENV=development
PORT=3000

# Postgres connection string (Supabase: Project Settings -> Database ->
# Connection string -> URI; use the pooled connection string, not the direct
# one - the direct host is often IPv6-only and unreachable from many
# networks/CI runners).
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# --- Provider credentials -----------------------------------------------
# All optional at the app level: the server boots fine with any subset
# configured, so each provider can be set up and verified independently.
# An adapter only errors when you actually try to run it without its
# credential.

# HubSpot: Settings -> Integrations -> Private Apps -> create one with
# "crm.objects.contacts.read" scope -> copy the generated access token.
HUBSPOT_ACCESS_TOKEN=

# Google Calendar: create a Service Account in Google Cloud Console, enable
# the Calendar API, download its JSON key, then share the target calendar
# with the service account's email (Calendar -> Settings and sharing ->
# Share with specific people -> paste the service account email, grant
# "See all event details" or higher).
GOOGLE_CALENDAR_ID=your-email@gmail.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key field from the downloaded JSON key as a single line
# with literal \n for newlines - the app un-escapes them at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe: Dashboard (test mode) -> Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook endpoint signing secret: Dashboard -> Developers -> Webhooks
# -> add endpoint (https://<your-host>/webhooks/stripe) -> Signing secret.
# For local testing without a public URL, the Stripe CLI (`stripe listen
# --forward-to localhost:3000/webhooks/stripe`) prints a temporary one.
STRIPE_WEBHOOK_SECRET=whsec_...
